# Base URL for the REST API. Defaults to /api when omitted.
VITE_API_BASE_URL=http://localhost:3000/api

# PEM-encoded RSA public key (SPKI) used by POST /auth/login to wrap an
# ephemeral AES-256-GCM key. The encrypted login body contains algorithm,
# encryptedKey, iv, and ciphertext fields.
# In a shell, encode line breaks as \n. Never place the matching private key in this app.
VITE_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
