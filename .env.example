# Conexão com o MySQL: usuario:senha@host:porta/banco
# O banco/tabelas podem ser criados com schema.sql (ou pelo startup da API).
DATABASE_URL=mysql+pymysql://manutencar:change-me@localhost:3306/manutencar

# Chave usada para assinar os tokens JWT (troque por um valor longo e aleatorio).
JWT_SECRET=replace-with-a-long-random-secret

# Tempo de validade do token de acesso, em minutos.
JWT_EXPIRES_MINUTES=60

# Chave privada RSA que descriptografa o login. Gere com os comandos do README
# e NUNCA versione este arquivo.
AUTH_PRIVATE_KEY_PATH=./secrets/auth-private-key.pem

# Origens do frontend liberadas no CORS (separe por virgula se houver mais de uma).
FRONTEND_ORIGINS=http://localhost:5173
