# URL base da API REST. O backend roda por padrao em 127.0.0.1:8000 (ver backend/README.md).
# Se VITE_API_BASE_URL for omitida, o cliente usa "/api" (precisa de proxy no Vite).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# PEM-encoded RSA public key (SPKI) used by POST /auth/login to wrap an
# ephemeral AES-256-GCM key. The encrypted login body contains algorithm,
# encryptedKey, iv, and ciphertext fields.
# A chave publica abaixo precisa ser o par da chave privada configurada em
# backend/.env (AUTH_PRIVATE_KEY_PATH). Gere o par com os comandos do backend/README.md.
# In a shell, encode line breaks as \n. Never place the matching private key in this app.
VITE_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
